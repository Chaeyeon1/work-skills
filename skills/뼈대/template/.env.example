# 복사해서 .env 로 쓴다: cp .env.example .env  (값은 바꾼다. .env 는 커밋하지 않는다)
HOST=0.0.0.0
PORT=8000
DB_PATH=var/app.db
DATASETS_DIR=data/datasets
INITIAL_DATASET=data/provided
EXPORT_DIR=out
# 현지 시각 기준('오늘'·'지금'). 서버 시계가 UTC 여도 이 값으로 본다
APP_UTC_OFFSET=+09:00
SESSION_HOURS=12
OPERATOR_USER=operator
OPERATOR_PASSWORD=change-me
MEMBER_INITIAL_PASSWORD=change-me-too
